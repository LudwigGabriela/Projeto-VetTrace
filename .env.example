# Copie para .env e ajuste conforme sua máquina
# cp .env.example .env
# O Docker Compose lê este arquivo automaticamente. Guia: docs/docker.md

POSTGRES_USER=vettrace
POSTGRES_PASSWORD=vettrace
POSTGRES_DB=vettrace

# Porta do banco NO SEU COMPUTADOR (DBeaver/pgAdmin e Flask fora do Docker).
# Use 5433 se você já tem PostgreSQL instalado na 5432
POSTGRES_PORT=5432

# Porta das páginas no seu computador -> http://localhost:8080
FRONTEND_PORT=8080

# Backend Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=troque-em-producao
# Só para rodar o Flask FORA do Docker (python run.py): usuário, senha e porta
# precisam bater com os de cima. Dentro do Docker o docker-compose.yml monta a
# URL sozinho, apontando para o container "db".
DATABASE_URL=postgresql://vettrace:vettrace@localhost:5432/vettrace